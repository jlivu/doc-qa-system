# ── LLM ──────────────────────────────────────────────────────────────────────
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# LLM model to use for answer generation
LLM_MODEL=gpt-4o-mini

# Embedding model — text-embedding-3-small is fast and cheap; swap to
# text-embedding-3-large for higher accuracy at higher cost
EMBEDDING_MODEL=text-embedding-3-small

# ── Qdrant ───────────────────────────────────────────────────────────────────
# When running via docker compose, this points at the qdrant service name
QDRANT_URL=http://qdrant:6333

# Name of the Qdrant collection that stores document chunks
QDRANT_COLLECTION=documents

# ── Ingestion ────────────────────────────────────────────────────────────────
# Number of characters per chunk (not tokens)
CHUNK_SIZE=800

# Overlap between consecutive chunks — preserves context across boundaries
CHUNK_OVERLAP=100

# How many chunks to retrieve per query
RETRIEVAL_TOP_K=5

# ── API ───────────────────────────────────────────────────────────────────────
# Origins allowed to call the API (comma-separated)
# Use * for development; restrict in production
CORS_ORIGINS=http://localhost:8501

# ── Local override ───────────────────────────────────────────────────────────
# When running the API outside Docker (e.g. uvicorn directly), point at localhost
# QDRANT_URL=http://localhost:6333
