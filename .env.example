# ── Ollama ─────────────────────────────────────────────────────────────────────
# Base URL for the Ollama server (local LLM / embeddings)
# When running via docker compose, use host.docker.internal to reach
# Ollama running on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM model to use for answer generation
OLLAMA_LLM_MODEL=qwen2.5:7b

# Embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Qdrant ───────────────────────────────────────────────────────────────────
# When running via docker compose, this points at the qdrant service name
QDRANT_URL=http://qdrant:6333

# Name of the Qdrant collection that stores document chunks
QDRANT_COLLECTION=documents

# ── Ingestion ────────────────────────────────────────────────────────────────
# Number of characters per chunk (not tokens)
CHUNK_SIZE=800

# Overlap between consecutive chunks — preserves context across boundaries
CHUNK_OVERLAP=100

# How many chunks to retrieve per query
RETRIEVAL_TOP_K=5

# ── API ───────────────────────────────────────────────────────────────────────
# Origins allowed to call the API (comma-separated)
# Use * for development; restrict in production
CORS_ORIGINS=http://localhost:8501

# ── Local override ───────────────────────────────────────────────────────────
# When running the API outside Docker (e.g. uvicorn directly), point at localhost
# QDRANT_URL=http://localhost:6333
# OLLAMA_BASE_URL=http://localhost:11434
